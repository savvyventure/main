<%- include('../partials/header') %>

<div class="page-header">
  <h1>Events</h1>
  <% if (currentUser) { %>
    <a href="/events/new/create" class="btn btn-primary">Create Event</a>
  <% } %>
</div>

<!-- Search & Filter Bar -->
<form class="filter-bar" method="GET" action="/events">
  <div class="filter-row">
    <input type="text" name="search" placeholder="Search events, artists, venues..."
           value="<%= filters.search || '' %>" class="filter-input">

    <select name="genre" class="filter-select">
      <option value="">All Genres</option>
      <% genres.forEach(g => { %>
        <option value="<%= g %>" <%= filters.genre === g ? 'selected' : '' %>><%= g %></option>
      <% }) %>
    </select>

    <input type="date" name="date_from" value="<%= filters.date_from || '' %>"
           class="filter-input" placeholder="From date">

    <input type="date" name="date_to" value="<%= filters.date_to || '' %>"
           class="filter-input" placeholder="To date">

    <button type="submit" class="btn btn-primary">Search</button>
    <a href="/events" class="btn btn-outline">Clear</a>
  </div>
</form>

<!-- Event Listing -->
<% if (events.length === 0) { %>
  <div class="empty-state">
    <p>No events found. <% if (currentUser) { %><a href="/events/new/create">Create one!</a><% } %></p>
  </div>
<% } else { %>
  <div class="events-grid">
    <% events.forEach(event => { %>
      <a href="/events/<%= event.id %>" class="event-card">
        <div class="event-card-header">
          <span class="event-date"><%= new Date(event.event_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
          <% if (event.price > 0) { %>
            <span class="event-price"><%= event.currency %> <%= event.price.toFixed(2) %></span>
          <% } else { %>
            <span class="event-price free">FREE</span>
          <% } %>
        </div>
        <h3 class="event-card-title"><%= event.title %></h3>
        <p class="event-card-venue"><%= event.venue %></p>
        <% if (event.dj_artist) { %>
          <p class="event-card-artist"><%= event.dj_artist %></p>
        <% } %>
        <div class="event-card-footer">
          <% if (event.genre) { %>
            <span class="badge"><%= event.genre %></span>
          <% } %>
          <% if (event.avg_rating) { %>
            <span class="rating-badge"><%= event.avg_rating %> / 5 (<%= event.review_count %>)</span>
          <% } %>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
