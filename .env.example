# =============================================================
# SyncUp Environment Variables
# =============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Security
# Generate a secure random string for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-secure-session-secret-here

# Database
# PostgreSQL connection string
# For local development with PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/syncup
# For Railway, this is automatically provided
DATABASE_URL=postgresql://localhost/syncup

# Email Configuration (for password reset emails)
# SMTP server settings - use Gmail, SendGrid, Mailgun, etc.
# For Gmail: smtp.gmail.com, port 587, enable "App Passwords" in Google Account
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=SyncUp <noreply@syncup.com>

# Application URL (used in password reset emails)
APP_URL=http://localhost:3000
